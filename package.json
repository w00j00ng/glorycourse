{
  "name": "glorycourse",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning backend/src/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning tests/run.mjs",
    "test:coverage": "c8 npm run verify && node scripts/coverage-report.mjs",
    "test:crash": "node --experimental-strip-types --disable-warning=ExperimentalWarning tests/operational/crash-write.test.mjs",
    "test:scale": "node --experimental-strip-types --disable-warning=ExperimentalWarning tests/operational/allocation-scale.test.mjs",
    "test:storage-scale": "node --experimental-strip-types --disable-warning=ExperimentalWarning tests/operational/storage-scale.test.mjs",
    "test:workbook-scale": "node --experimental-strip-types --disable-warning=ExperimentalWarning tests/operational/workbook-scale.test.mjs",
    "test:openapi": "redocly lint openapi/openapi.yaml --extends=spec",
    "typecheck": "tsc --noEmit",
    "test:launcher": "node tests/operational/launcher.test.mjs",
    "test:desktop": "node tests/operational/desktop-open.test.mjs",
    "docs:html": "node scripts/build-guide.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node tests/operational/package-smoke.mjs",
    "migrations:manifest": "node scripts/migrations-manifest.mjs",
    "migrations:check": "node scripts/migrations-manifest.mjs --check",
    "verify": "npm run migrations:check && npm run test:openapi && npm run typecheck && npm test && npm run test:crash && npm run test:launcher"
  },
  "c8": {
    "all": true,
    "include": [
      "backend/src/**/*.ts",
      "frontend/**/*.js",
      "scripts/launcher.mjs",
      "scripts/runtime-paths.mjs"
    ],
    "extension": [
      ".ts",
      ".js",
      ".mjs"
    ],
    "reporter": [
      "text",
      "json-summary",
      "html",
      "lcovonly"
    ]
  },
  "devDependencies": {
    "@redocly/cli": "2.54.2",
    "@types/node": "22.20.4",
    "c8": "12.0.0",
    "marked": "16.0.0",
    "typescript": "5.9.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@excel.js/exceljs": "0.15.0",
    "@excel.js/jszip": "0.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
